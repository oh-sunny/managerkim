# The Supabase runtime injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Set these four secrets in Supabase Dashboard > Edge Functions > Secrets.
SYNC_OWNER_ID=your_supabase_auth_user_uuid
SYNC_CRON_SERVICE_KEY=your_project_legacy_service_role_jwt
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id
GOOGLE_SHEETS_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
