{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "prototype",
  "functions": {
    "api/index.js": {
      "maxDuration": 180,
      "includeFiles": "node_modules/pdfjs-dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ]
}
